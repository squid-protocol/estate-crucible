//BDLDPRC  PROC HLQ=PROD,RPT=DAILY
//*
//SRT010   EXEC PGM=SORT
//SORTIN   DD DSN=&HLQ..BDLD.TRANS,DISP=SHR
//SORTOUT  DD DSN=&&WORK,DISP=(NEW,PASS),UNIT=SYSDA,SPACE=(CYL,(1,1)),
//             DCB=(RECFM=FB,LRECL=40)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,A)
/*
//*
//RPT020   EXEC PGM=BDLDRPT,PARM='&RPT'
//STEPLIB  DD DSN=&HLQ..BDLD.LOADLIB,DISP=SHR
//RPTOUT   DD SYSOUT=A
//         PEND
