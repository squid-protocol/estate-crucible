//BDLDNITE JOB (BDLD,0100),'BDLD NIGHTLY CHAIN',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* SORT THE EXTRACT, LOAD IT UNDER IKJEFT01, REPORT OR COPY THE ERRORS
//*
//SORT010  EXEC PGM=SORT
//SORTIN   DD DSN=PROD.BDLD.TRANS,DISP=SHR
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS),UNIT=SYSDA,
//             SPACE=(CYL,(5,1)),DCB=(RECFM=FB,LRECL=40)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,A)
 INCLUDE COND=(35,1,CH,EQ,C'A')
/*
//*
//LOAD020  EXEC PGM=IKJEFT01,COND=(4,LT,SORT010)
//STEPLIB  DD DSN=DSN.V13R1.SDSNLOAD,DISP=SHR
//         DD DSN=PROD.BDLD.LOADLIB,DISP=SHR
//SORTED   DD DSN=&&SORTED,DISP=(OLD,DELETE)
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
 DSN SYSTEM(DB2P)
 RUN PROGRAM(BDLDDB2) PLAN(BDLDPLN) LIB('PROD.BDLD.LOADLIB')
 END
/*
//*
//IFOK     IF (LOAD020.RC = 0) THEN
//*
//RPT030   EXEC PGM=BDLDRPT
//STEPLIB  DD DSN=PROD.BDLD.LOADLIB,DISP=SHR
//RPTOUT   DD SYSOUT=A
//         ELSE
//*
//ERR040   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=PROD.BDLD.ERRMSG,DISP=SHR
//SYSUT2   DD SYSOUT=A
//SYSIN    DD DUMMY
//         ENDIF
