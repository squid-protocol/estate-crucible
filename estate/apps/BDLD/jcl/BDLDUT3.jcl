//BDLDUT3  JOB (BDLD,0100),'BDLD UTILITIES 3',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//ICE010   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//IN       DD DSN=PROD.BDLD.XREFIN,DISP=SHR
//OUT      DD DSN=PROD.BDLD.DUPS,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=40)
//RPT      DD SYSOUT=*
//TOOLIN   DD *
COUNT FROM(IN) EMPTY
SELECT FROM(IN) TO(OUT) ON(1,10,CH) ALLDUPS
OCCUR FROM(IN) LIST(RPT) ON(1,10,CH)
STATS FROM(IN) ON(21,5,ZD)
/*
//*
//SRT020   EXEC PGM=SORT
//SORTIN   DD DSN=PROD.BDLD.XREFIN,DISP=SHR
//SORTOUT  DD DSN=PROD.BDLD.XREFFLG,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=40)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,A)
 INREC IFTHEN=(WHEN=(35,1,CH,EQ,C'A'),OVERLAY=(36:C'ACTIVE'))
/*
//*
//SRT030   EXEC PGM=SORT
//SORTIN   DD DSN=PROD.BDLD.XREFCSV,DISP=SHR
//SYSOUT   DD SYSOUT=*
//OUT1     DD DSN=PROD.BDLD.PARSED1,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=40)
//OUT2     DD DSN=PROD.BDLD.PARSED2,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=40)
//SYSIN    DD *
 SORT FIELDS=COPY
 INREC PARSE=(%01=(ENDBEFR=C',',FIXLEN=10)),BUILD=(%01,11:C'X')
 OUTFIL FNAMES=OUT1,OVERLAY=(41:C'ZZ')
 OUTFIL FNAMES=OUT2,BUILD=(1,10,C' ',11,5)
/*
//*
//UPD040   EXEC PGM=IEBUPDTE,PARM='NEW'
//SYSPRINT DD SYSOUT=*
//SYSUT2   DD DSN=PROD.BDLD.NOTES,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(TRK,(5,1,5)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD *
./ ADD NAME=BDLDNOTE,LIST=ALL
BDLD NIGHTLY RUN NOTES, LINE ONE
BDLD NIGHTLY RUN NOTES, LINE TWO
./ ENDUP
/*
//*
//PCH050   EXEC PGM=IEBPTPCH
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=PROD.BDLD.NOTES,DISP=SHR
//SYSUT2   DD SYSOUT=A
//SYSIN    DD *
 PRINT TYPORG=PO,MAXFLDS=1
 MEMBER NAME=BDLDNOTE
 RECORD FIELD=(80)
/*
//*
//CMP060   EXEC PGM=IEBCOMPR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=PROD.BDLD.XREFIN,DISP=SHR
//SYSUT2   DD DSN=PROD.BDLD.XREFFLG,DISP=SHR
//SYSIN    DD *
 COMPARE TYPORG=PS
/*
//*
//ALC070   EXEC PGM=IEFBR14
//NEWDD    DD DSN=PROD.BDLD.WORKFILE,DISP=(NEW,CATLG),UNIT=SYSDA,
//             SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=40)
//*
//DEL080   EXEC PGM=IEFBR14
//OLDDD    DD DSN=PROD.BDLD.WORKFILE,DISP=(OLD,DELETE)
