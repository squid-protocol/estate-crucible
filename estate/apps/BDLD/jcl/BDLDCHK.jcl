//BDLDCHK  JOB (BDLD,0100),'BDLD CHECKPOINT RUN',CLASS=A,MSGCLASS=X,
//             RESTART=(CHK020,C0000012),NOTIFY=&SYSUID
//* RESUBMITTED FROM CHECKPOINT C0000012 TAKEN IN CHK020
//SYSCHK   DD DSN=PROD.BDLD.CHKPT,DISP=(OLD,KEEP)
//*
//CHK010   EXEC PGM=SORT
//SORTIN   DD DSN=PROD.BDLD.TRANS,DISP=SHR
//SORTOUT  DD DSN=PROD.BDLD.CHKSORT,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(5,1)),DCB=(RECFM=FB,LRECL=40)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,A)
/*
//*
//CHK020   EXEC PGM=SORT,RD=R
//SORTIN   DD DSN=PROD.BDLD.CHKSORT,DISP=SHR
//SORTOUT  DD DSN=PROD.BDLD.CHKOUT,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(5,1)),DCB=(RECFM=FB,LRECL=40)
//SYSCKEOV DD DSN=PROD.BDLD.CHKEOV,DISP=(MOD,KEEP)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,D)
/*
