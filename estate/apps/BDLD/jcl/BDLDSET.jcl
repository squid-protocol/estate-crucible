//BDLDSET  JOB (BDLD,0100),'BDLD SET NULLFILE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//SETV     SET HLQ=PROD
//SET010   EXEC PGM=SORT
//SORTIN   DD DSN=&HLQ..BDLD.TRANS,DISP=SHR
//SORTOUT  DD DSN=PROD.BDLD.SETOUT,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(5,1)),DCB=(RECFM=FB,LRECL=40)
//SYSOUT   DD SYSOUT=*
//SORTWK01 DD DSN=NULLFILE
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,A)
/*
