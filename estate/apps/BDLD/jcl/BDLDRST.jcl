//BDLDRST  JOB (BDLD,0100),'BDLD RESTART CHAIN',CLASS=A,MSGCLASS=X,
//             RESTART=LOAD020,NOTIFY=&SYSUID
//* RESUBMITTED WITH RESTART=LOAD020: SORT010 ALREADY RAN, ITS OUTPUT IS CATALOGED
//*
//SORT010  EXEC PGM=SORT
//SORTIN   DD DSN=PROD.BDLD.TRANS,DISP=SHR
//SORTOUT  DD DSN=PROD.BDLD.SORTED,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(5,1)),DCB=(RECFM=FB,LRECL=40)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,A)
/*
//*
//LOAD020  EXEC PGM=IKJEFT01
//STEPLIB  DD DSN=DSN.V13R1.SDSNLOAD,DISP=SHR
//SORTED   DD DSN=PROD.BDLD.SORTED,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
 DSN SYSTEM(DB2P)
 RUN PROGRAM(BDLDDB2) PLAN(BDLDPLN) LIB('PROD.BDLD.LOADLIB')
 END
/*
//*
//RPT030   EXEC PGM=BDLDRPT,PARM='MONTHLY'
//STEPLIB  DD DSN=PROD.BDLD.LOADLIB,DISP=SHR
//RPTOUT   DD SYSOUT=A
