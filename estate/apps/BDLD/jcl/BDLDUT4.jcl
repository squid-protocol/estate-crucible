//BDLDUT4  JOB (BDLD,0100),'BDLD UTILITIES 4',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//DMP010   EXEC PGM=ADRDSSU
//SYSPRINT DD SYSOUT=*
//DROUT    DD DSN=PROD.BDLD.DUMP,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(5,1))
//SYSIN    DD *
 DUMP DATASET(INCLUDE(PROD.BDLD.**)) -
      OUTDDNAME(DROUT)
/*
//*
//RST020   EXEC PGM=ADRDSSU
//SYSPRINT DD SYSOUT=*
//DRIN     DD DSN=PROD.BDLD.DUMP,DISP=SHR
//SYSIN    DD *
 RESTORE DATASET(INCLUDE(PROD.BDLD.**)) -
      INDDNAME(DRIN)
/*
//*
//IMG030   EXEC PGM=IEBIMAGE
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=SYS1.IMAGELIB,DISP=OLD
//SYSIN    DD *
 FCB CH1=1,CH12=80,LPI=8
 NAME BDLD
/*
