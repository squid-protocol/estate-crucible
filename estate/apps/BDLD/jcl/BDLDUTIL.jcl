//BDLDUTIL JOB (BDLD,0100),'BDLD UTILITIES',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//IDC010   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INDD     DD DSN=PROD.BDLD.XREFIN,DISP=SHR
//SYSIN    DD *
 DELETE PROD.BDLD.XREF CLUSTER PURGE
 SET MAXCC=0
 DEFINE CLUSTER (NAME(PROD.BDLD.XREF) -
        INDEXED KEYS(10 0) RECORDSIZE(40 40) -
        CYLINDERS(1 1))
 REPRO INFILE(INDD) OUTDATASET(PROD.BDLD.XREF)
/*
//*
//GEN020   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=PROD.BDLD.XREFIN,DISP=SHR
//SYSUT2   DD DSN=PROD.BDLD.XREFBAK,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=40)
//SYSIN    DD DUMMY
//*
//ICE030   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//INDD     DD DSN=PROD.BDLD.XREFIN,DISP=SHR
//OUTDD    DD DSN=PROD.BDLD.XREFOUT,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=40)
//TOOLIN   DD *
 COPY FROM(INDD) TO(OUTDD) USING(CTL1)
/*
//CTL1CNTL DD *
 OMIT COND=(35,1,CH,EQ,C'X')
/*
//*
//SRT040   EXEC PGM=SORT
//SORTIN   DD DSN=PROD.BDLD.XREFIN,DISP=SHR
//SORTOUT  DD DSN=PROD.BDLD.XREFSUM,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=40)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,A)
 INREC FIELDS=(1,40)
 SUM FIELDS=(21,5,ZD)
 OUTREC FIELDS=(1,25,15X)
/*
