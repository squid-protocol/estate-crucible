//BDLDUT2  JOB (BDLD,0100),'BDLD UTILITIES 2',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//IDC010   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 LISTCAT ENTRIES(PROD.BDLD.XREF) ALL
 ALTER PROD.BDLD.XREF -
       NEWNAME(PROD.BDLD.XREF2)
 PRINT INDATASET(PROD.BDLD.XREF2) COUNT(10)
/*
//*
//CPY020   EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=PROD.BDLD.LOADLIB,DISP=SHR
//SYSUT2   DD DSN=PROD.BDLD.LOADBAK,DISP=SHR
//SYSIN    DD *
 COPY OUTDD=SYSUT2,INDD=SYSUT1
 SELECT MEMBER=(BDLDRPT,BDLDDB2)
/*
//*
//JNK030   EXEC PGM=SORT
//SORTJNF1 DD DSN=PROD.BDLD.XREFIN,DISP=SHR
//SORTJNF2 DD DSN=PROD.BDLD.XREFOUT,DISP=SHR
//SYSOUT   DD SYSOUT=*
//OUT1     DD DSN=PROD.BDLD.JOINED,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=50)
//OUT2     DD DSN=PROD.BDLD.JOINREST,DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=50)
//SYSIN    DD *
 JOINKEYS F1=SORTJNF1,FIELDS=(1,10,A)
 JOINKEYS F2=SORTJNF2,FIELDS=(1,10,A)
 REFORMAT FIELDS=(F1:1,40,F2:11,10)
 SORT FIELDS=COPY
 OUTFIL FNAMES=OUT1,INCLUDE=(35,1,CH,EQ,C'A')
 OUTFIL FNAMES=OUT2,SAVE
/*
