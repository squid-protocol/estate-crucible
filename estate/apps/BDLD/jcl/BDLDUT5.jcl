//BDLDUT5  JOB (BDLD,0100),'BDLD UTILITIES 5',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//BPX010   EXEC PGM=BPXBATCH,PARM='SH /u/bdld/bin/purge.sh 30'
//STDOUT   DD SYSOUT=*
//STDERR   DD SYSOUT=*
//STDENV   DD *
LANG=En_US.IBM-1047
LC_ALL=En_US.IBM-1047
/*
//*
//BPX020   EXEC PGM=BPXBATCH
//STDOUT   DD SYSOUT=*
//STDERR   DD SYSOUT=*
//STDPARM  DD *
SH /u/bdld/bin/purge.sh AAAA
BBBB
/*
//*
//RUN030   EXEC PGM=DSNUTILB,PARM='DB2P,BDLDRUNS'
//STEPLIB  DD DSN=DSN.V13R1.SDSNLOAD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//UTPRINT  DD SYSOUT=*
//SYSIN    DD *
RUNSTATS TABLESPACE BDLDDB.BDLDTS
      UPDATE SPACE
/*
//*
//BND040   EXEC PGM=IKJEFT01
//STEPLIB  DD DSN=DSN.V13R1.SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=PROD.BDLD.DBRMLIB,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
 DSN SYSTEM(DB2P)
 BIND PACKAGE(BDLDCOLL) MEMBER(BDLDDB2) -
      ACTION(REPLACE)
 BIND PLAN(BDLDPLN) PKLIST(BDLDCOLL.*) -
      ACTION(REPLACE)
 END
/*
