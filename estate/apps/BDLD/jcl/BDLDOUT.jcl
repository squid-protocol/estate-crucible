//BDLDOUT  JOB (BDLD,0100),'BDLD OUTPUT STATEMEN',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//OUT1     OUTPUT DEST=NYC01,CLASS=A
//OUT2     OUTPUT CONTROL=DOUBLE
//*
//OUT010   EXEC PGM=BDLDRPT
//LOCAL    OUTPUT COPIES=2
//STEPLIB  DD DSN=PROD.BDLD.LOADLIB,DISP=SHR
//RPTOUT   DD SYSOUT=A,OUTPUT=(*.OUT1,*.OUT2,*.LOCAL)
//*
//OUT020   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=PROD.BDLD.ERRMSG,DISP=SHR
//SYSUT2   DD SYSOUT=A,OUTPUT=*.OUT010.LOCAL
//SYSIN    DD DUMMY
