//BDLDSYS  JOB (BDLD,0100),'BDLD SYSOUT AND COND',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//SYS010   EXEC PGM=BDLDRPT
//STEPLIB  DD DSN=PROD.BDLD.LOADLIB,DISP=SHR
//RPTOUT   DD SYSOUT=(A,,STD1)
//AUDIT    DD SYSOUT=Z,DEST=NYC01
//SYSUDUMP DD SYSOUT=*
//TRACE    DD DUMMY
//*
//SYS020   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=PROD.BDLD.ERRMSG,DISP=SHR
//SYSUT2   DD SYSOUT=A
//SYSIN    DD DUMMY
//*
//SYS030   EXEC PGM=IEBGENER,COND=((4,LT,SYS010),ONLY)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=PROD.BDLD.ERRMSG,DISP=SHR
//SYSUT2   DD SYSOUT=(B,,ERR1)
//SYSIN    DD DUMMY
