//BDLDGDG  JOB (BDLD,0100),'BDLD GDG ROLL',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//GEN010   EXEC PGM=SORT
//SORTIN   DD DSN=PROD.BDLD.MASTER(0),DISP=SHR
//         DD DSN=PROD.BDLD.DELTA,DISP=SHR
//SORTOUT  DD DSN=PROD.BDLD.MASTER(+1),DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(5,1)),DCB=(RECFM=FB,LRECL=40)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,A)
/*
