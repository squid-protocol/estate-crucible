//MQBRRUN  JOB (MQBR,0100),'MQBR BRIDGE SENDERS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* SEND ONE ORDER TO IMS AND ONE TO CICS THROUGH THEIR BRIDGE QUEUES
//*
//IMS010   EXEC PGM=MQBRIMS
//STEPLIB  DD DSN=PROD.MQBR.LOADLIB,DISP=SHR
//         DD DSN=MQM.SCSQAUTH,DISP=SHR
//         DD DSN=MQM.SCSQLOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//CIC020   EXEC PGM=MQBRCIH
//STEPLIB  DD DSN=PROD.MQBR.LOADLIB,DISP=SHR
//         DD DSN=MQM.SCSQAUTH,DISP=SHR
//         DD DSN=MQM.SCSQLOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
