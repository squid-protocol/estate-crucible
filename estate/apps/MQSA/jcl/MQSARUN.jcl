//MQSARUN  JOB (MQSA,0100),'MQSA ORDER FLOW',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* PUT, DRAIN, REPLY AND INQUIRE; THE MQ LOAD LIBRARIES RIDE IN THE STEPLIB CONCATENATION
//*
//PUT010   EXEC PGM=MQSAPUT
//STEPLIB  DD DSN=PROD.MQSA.LOADLIB,DISP=SHR
//         DD DSN=MQM.SCSQAUTH,DISP=SHR
//         DD DSN=MQM.SCSQLOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//GET020   EXEC PGM=MQSAGET
//STEPLIB  DD DSN=PROD.MQSA.LOADLIB,DISP=SHR
//         DD DSN=MQM.SCSQAUTH,DISP=SHR
//         DD DSN=MQM.SCSQLOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//REP030   EXEC PGM=MQSAREP
//STEPLIB  DD DSN=PROD.MQSA.LOADLIB,DISP=SHR
//         DD DSN=MQM.SCSQAUTH,DISP=SHR
//         DD DSN=MQM.SCSQLOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//INQ040   EXEC PGM=MQSAINQ
//STEPLIB  DD DSN=PROD.MQSA.LOADLIB,DISP=SHR
//         DD DSN=MQM.SCSQAUTH,DISP=SHR
//         DD DSN=MQM.SCSQLOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
