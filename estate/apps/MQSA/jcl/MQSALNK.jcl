//MQSALNK  JOB (MQSA,0100),'MQSA LINK-EDIT WITH ',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* LINK THE RRS PROGRAM WITH CSQBRSTB AND THE CALLABLE SERVICES STUB, THE MQ-ONLY PROGRAM WITH CSQBSTUB
//*
//LKRRS10  EXEC PGM=IEWL,PARM='LIST,MAP'
//SYSPRINT DD SYSOUT=*
//SYSLIB   DD DSN=MQM.SCSQLOAD,DISP=SHR
//         DD DSN=SYS1.CSSLIB,DISP=SHR
//SYSLMOD  DD DSN=PROD.MQSA.LOADLIB,DISP=SHR
//OBJLIB   DD DSN=PROD.MQSA.OBJLIB,DISP=SHR
//SYSLIN   DD *
 INCLUDE SYSLIB(CSQBRSTB)
 INCLUDE SYSLIB(ATRSCSS)
 INCLUDE OBJLIB(MQSARRS)
 NAME MQSARRS(R)
/*
//*
//LKBKO20  EXEC PGM=IEWL,PARM='LIST,MAP'
//SYSPRINT DD SYSOUT=*
//SYSLIB   DD DSN=MQM.SCSQLOAD,DISP=SHR
//SYSLMOD  DD DSN=PROD.MQSA.LOADLIB,DISP=SHR
//OBJLIB   DD DSN=PROD.MQSA.OBJLIB,DISP=SHR
//SYSLIN   DD *
 INCLUDE SYSLIB(CSQBSTUB)
 INCLUDE OBJLIB(MQSABKO)
 NAME MQSABKO(R)
/*
