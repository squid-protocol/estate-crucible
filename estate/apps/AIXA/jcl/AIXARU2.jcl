//AIXARU2  JOB (AIXA,0100),'AIXA ORDER RUN 2',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//RRS010   EXEC PGM=AIXARRS
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//SLOTIN   DD DSN=PROD.AIXA.SLOTS,DISP=OLD
//SLOTOUT  DD DSN=PROD.AIXA.SLOTH,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//ESU020   EXEC PGM=AIXAESU
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//LOGUPD   DD DSN=PROD.AIXA.LOG,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//KS3040   EXEC PGM=AIXAKS3
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//CUSKSD   DD DSN=PROD.AIXA.CUST,DISP=OLD
//CUSKSD1  DD DSN=PROD.AIXA.CUST.TAXPATH,DISP=OLD
//CUSKSD2  DD DSN=PROD.AIXA.CUST.NAMPATH,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//KS2030   EXEC PGM=AIXAKS2
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//CUSKSD   DD DSN=PROD.AIXA.CUST,DISP=OLD
//CUSKSD1  DD DSN=PROD.AIXA.CUST.TAXPATH,DISP=OLD
//CUSKSD2  DD DSN=PROD.AIXA.CUST.NAMPATH,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//MD5050   EXEC PGM=AIXAMOD
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//CUSKSD   DD DSN=PROD.AIXA.CUST,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//VR6060   EXEC PGM=AIXAVAR
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//NOTKSD   DD DSN=PROD.AIXA.NOTES,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//VW7070   EXEC PGM=AIXAVRW
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//LOGUPD   DD DSN=PROD.AIXA.LOG,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//VK8080   EXEC PGM=AIXAVKW
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//NOTUPD   DD DSN=PROD.AIXA.NOTES,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//UX9090   EXEC PGM=AIXAUXF
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//UXOUT    DD PATH='/u/aixa/extract/orders.dat',
//             PATHOPTS=(ORDWR,OCREAT),PATHMODE=(SIRUSR,SIWUSR),
//             FILEDATA=BINARY
//SYSOUT   DD SYSOUT=*
