//AIXARU2  JOB (AIXA,0100),'AIXA ORDER RUN 2',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//RRS010   EXEC PGM=AIXARRS
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//SLOTIN   DD DSN=PROD.AIXA.SLOTS,DISP=OLD
//SLOTOUT  DD DSN=PROD.AIXA.SLOTH,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//ESU020   EXEC PGM=AIXAESU
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//LOGUPD   DD DSN=PROD.AIXA.LOG,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//KS2030   EXEC PGM=AIXAKS2
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//CUSKSD   DD DSN=PROD.AIXA.CUST,DISP=OLD
//CUSKSD1  DD DSN=PROD.AIXA.CUST.TAXPATH,DISP=OLD
//CUSKSD2  DD DSN=PROD.AIXA.CUST.NAMPATH,DISP=OLD
//SYSOUT   DD SYSOUT=*
