//AIXARUN  JOB (AIXA,0100),'AIXA ORDER RUN',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//KSD010   EXEC PGM=AIXAKSD
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//ORDKSD   DD DSN=PROD.AIXA.ORDER,DISP=OLD
//ORDKSD1  DD DSN=PROD.AIXA.ORDER.PATH,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//RRD020   EXEC PGM=AIXARRD
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//SLOTS    DD DSN=PROD.AIXA.SLOTS,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//ESD030   EXEC PGM=AIXAESD
//STEPLIB  DD DSN=PROD.AIXA.LOADLIB,DISP=SHR
//LOGESD   DD DSN=PROD.AIXA.LOG,DISP=OLD
//SYSOUT   DD SYSOUT=*
