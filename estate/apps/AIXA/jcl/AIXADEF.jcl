//AIXADEF  JOB (AIXA,0100),'AIXA DEFINE VSAM',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* DEFINE THE ORDER KSDS, ITS ALTERNATE INDEX AND PATH, THE SLOT RRDS AND THE LOG ESDS
//*
//IDC010   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE CLUSTER (NAME(PROD.AIXA.ORDER) -
        INDEXED KEYS(8 0) RECORDSIZE(40 40) -
        CYLINDERS(1 1))
 DEFINE CLUSTER (NAME(PROD.AIXA.SLOTS) -
        NUMBERED RECORDSIZE(40 40) -
        CYLINDERS(1 1))
 DEFINE CLUSTER (NAME(PROD.AIXA.LOG) -
        NONINDEXED RECORDSIZE(60 60) -
        CYLINDERS(1 1))
/*
//*
//IDC020   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE ALTERNATEINDEX (NAME(PROD.AIXA.ORDER.AIX) -
        RELATE(PROD.AIXA.ORDER) KEYS(8 8) -
        NONUNIQUEKEY UPGRADE CYLINDERS(1 1))
 DEFINE PATH (NAME(PROD.AIXA.ORDER.PATH) -
        PATHENTRY(PROD.AIXA.ORDER.AIX) UPDATE)
 BLDINDEX INDATASET(PROD.AIXA.ORDER) -
        OUTDATASET(PROD.AIXA.ORDER.AIX)
/*
