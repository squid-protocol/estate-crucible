//AIXADF3  JOB (AIXA,0100),'AIXA DEFINE LINEAR Z',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* DEFINE THE LINEAR EXTRACT DATA SET AND THE ZFS AGGREGATE FOR THE ORDER REPORTS
//*
//IDC010   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE CLUSTER (NAME(PROD.AIXA.EXTRACT) -
        LINEAR CONTROLINTERVALSIZE(4096) -
        CYLINDERS(1 1))
 DEFINE CLUSTER (NAME(PROD.AIXA.REPORTS.ZFS) -
        ZFS CYLINDERS(5 1))
/*
