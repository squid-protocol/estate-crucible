//AIXADF4  JOB (AIXA,0100),'AIXA DEFINE AUDIT AI',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* DEFINE THE AUDIT KSDS WITH A NOUPGRADE ALTERNATE INDEX AND A NOUPDATE PATH
//*
//IDC010   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE CLUSTER (NAME(PROD.AIXA.AUDIT) -
        INDEXED KEYS(8 0) RECORDSIZE(40 40) -
        CYLINDERS(1 1))
 DEFINE ALTERNATEINDEX (NAME(PROD.AIXA.AUDIT.AIX) -
        RELATE(PROD.AIXA.AUDIT) KEYS(8 8) -
        NONUNIQUEKEY NOUPGRADE CYLINDERS(1 1))
 DEFINE PATH (NAME(PROD.AIXA.AUDIT.PATH) -
        PATHENTRY(PROD.AIXA.AUDIT.AIX) NOUPDATE)
 BLDINDEX INDATASET(PROD.AIXA.AUDIT) -
        OUTDATASET(PROD.AIXA.AUDIT.AIX)
/*
