//AIXADF2  JOB (AIXA,0100),'AIXA DEFINE VSAM 2',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* DEFINE THE HISTORY RRDS, THE CUSTOMER KSDS, TWO ALTERNATE INDEXES AND THEIR PATHS
//*
//IDC010   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE CLUSTER (NAME(PROD.AIXA.SLOTH) -
        NUMBERED RECORDSIZE(40 40) -
        CYLINDERS(1 1))
/*
//*
//IDC020   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE CLUSTER (NAME(PROD.AIXA.CUST) -
        INDEXED KEYS(8 0) RECORDSIZE(40 40) -
        CYLINDERS(1 1))
 DEFINE ALTERNATEINDEX (NAME(PROD.AIXA.CUST.TAXAIX) -
        RELATE(PROD.AIXA.CUST) KEYS(9 8) -
        UNIQUEKEY UPGRADE CYLINDERS(1 1))
 DEFINE ALTERNATEINDEX (NAME(PROD.AIXA.CUST.NAMAIX) -
        RELATE(PROD.AIXA.CUST) KEYS(20 17) -
        NONUNIQUEKEY UPGRADE CYLINDERS(1 1))
 DEFINE PATH (NAME(PROD.AIXA.CUST.TAXPATH) -
        PATHENTRY(PROD.AIXA.CUST.TAXAIX) UPDATE)
 DEFINE PATH (NAME(PROD.AIXA.CUST.NAMPATH) -
        PATHENTRY(PROD.AIXA.CUST.NAMAIX) UPDATE)
 BLDINDEX INDATASET(PROD.AIXA.CUST) -
        OUTDATASET(PROD.AIXA.CUST.TAXAIX)
 BLDINDEX INDATASET(PROD.AIXA.CUST) -
        OUTDATASET(PROD.AIXA.CUST.NAMAIX)
/*
