 "title": "A paragraph cut at a conditional or non-terminating GOBACK / RETURN / EXIT",
 "category": "unit-extent",
 "issue": 4301,
 "shapes": [
  "EXEC CICS / RETURN TRANSID(...) / END-EXEC inside IF ... END-IF, more statements after it (CUSTINQ 0000-MAIN)",
  "a paragraph whose name starts with RETURN (CUSTINQ RETURN-TO-MENU)",
  "EXIT PERFORM inside an inline PERFORM, more statements after the loop: unnumbered (CUSTINQ 4000-FIND-BLANK) and numbered (ACCTRPT 2500-SCAN-HISTORY)",
  "PL/I: IF CLM_AMT > 0 THEN ... ELSE RETURN; then CALL LOG_CLAIM / WRITE_CLAIM in CHECK_CLAIM (CLMPROC)"
 ],
 "asserts": "A paragraph runs from its header to just before the next paragraph or section header; the key's end_line is the last code line before that header. Every PERFORM after the conditional terminator belongs to the paragraph.",
 "citations": [
  {
   "doc": "Enterprise COBOL for z/OS 6.4 Language Reference",
   "section": "Procedure division structure > Procedures",
   "url": "https://www.ibm.com/docs/en/cobol-zos/6.4.0?topic=structure-procedures",
   "quote": "A paragraph ends immediately before the next paragraph-name or section header, or at the end of the PROCEDURE DIVISION."
  },
  {
   "doc": "CICS Transaction Server for z/OS 6.x",
   "section": "EXEC CICS RETURN",
   "url": "https://www.ibm.com/docs/en/cics-ts/6.x?topic=summary-return",
   "quote": "RETURN returns control from an application program either to an application program at the next higher logical level, or to CICS."
  },
  {
   "doc": "Enterprise COBOL for z/OS 6.4 Language Reference",
   "section": "EXIT statement (EXIT PERFORM)",
   "url": "https://www.ibm.com/docs/en/cobol-zos/6.4.0?topic=statements-exit-statement",
   "quote": "The EXIT statement ... provides a way to exit from a section, a paragraph, or an inline PERFORM statement."
  },
  {
   "doc": "Enterprise PL/I for z/OS 6.1 Language Reference (SC31-5716-00)",
   "section": "RETURN statement (p.232)",
   "url": "https://publibfp.dhe.ibm.com/epubs/pdf/c3157160.pdf",
   "quote": "The RETURN statement terminates execution of the subroutine or function procedure that contains the RETURN statement and returns control to the invoking procedure."
  }
 ],
